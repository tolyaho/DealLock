# ---- DealLock Frontend Environment ----

# Sepolia RPC URL (optional — wagmi uses a public default if omitted).
# For higher reliability set your own Alchemy / Infura endpoint:
# VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
VITE_SEPOLIA_RPC_URL=

# Sepolia block explorer base URL (default: https://sepolia.etherscan.io)
VITE_SEPOLIA_EXPLORER=https://sepolia.etherscan.io

# Backend API base URL (default: http://localhost:4000)
VITE_API_URL=http://localhost:4000

# Legacy DealLock Factory V1 addresses.
# Factory V1 deploys native ETH-only V4-compatible agreements.
VITE_DEALLOCK_FACTORY_SEPOLIA=
VITE_DEALLOCK_FACTORY_HARDHAT=

# Payment-aware DealLock Factory V2 addresses.
# When set and Factory V3 is not set, new agreements are deployed as DealLockMultiAsset contracts.
# ETH remains available; configured ERC-20 assets such as USDC require approve + fund.
VITE_DEALLOCK_FACTORY_V2_SEPOLIA=
VITE_DEALLOCK_FACTORY_V2_HARDHAT=

# Payment-aware DealLock Factory V3 addresses.
# Preferred for new agreements. Deploys V6 DealLockMultiAssetV2 agreements with
# a 30-minute deadline grace window and client-approved extension requests.
VITE_DEALLOCK_FACTORY_V3_SEPOLIA=
VITE_DEALLOCK_FACTORY_V3_HARDHAT=

# Optional configured ERC-20 payment assets shown by the create form.
# Do not hardcode production token addresses without verifying the network and decimals.
VITE_USDC_SEPOLIA_ADDRESS=
VITE_USDC_HARDHAT_ADDRESS=
