# ── DealLock Backend Environment ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# All REQUIRED fields must be set before the backend will start in production.

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (REQUIRED).
# Local dev: use the docker-compose.yml postgres service (deallock/deallock).
DATABASE_URL="postgresql://deallock:deallock@localhost:5432/deallock?schema=public"

# Dedicated test database URL used only by `npm test`. Never point this at production.
DATABASE_URL_TEST="postgresql://deallock:deallock@localhost:5432/deallock_test?schema=public"

# ── Server ────────────────────────────────────────────────────────────────────

NODE_ENV="development"
PORT=4000

# Frontend origin allowed for CORS (REQUIRED).
# In production set this to your actual frontend URL, e.g. https://app.deallock.xyz
FRONTEND_ORIGIN="http://localhost:5173"

# ── Sessions ──────────────────────────────────────────────────────────────────

# Secret used to sign session cookies (REQUIRED).
# MUST be at least 32 random characters in production.
# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-long-random-secret"

# Session storage backend.
# Use "postgres" for all normal environments (development and production).
# "memory" is only safe for test isolation — NOT for production.
SESSION_STORE="postgres"

# Optional separate PostgreSQL URL for session storage (defaults to DATABASE_URL).
SESSION_DATABASE_URL=

# Session TTL in milliseconds (default: 7 days = 604800000).
SESSION_MAX_AGE_MS=604800000

# Set to true only behind a known reverse proxy (e.g. Render, Railway, Nginx).
TRUST_PROXY=false

# Cookie security — must be true in production HTTPS deployments.
SESSION_COOKIE_SECURE=false

# SameSite cookie attribute: lax | strict | none.
# Use "none" only when the backend and frontend are on different origins AND
# SESSION_COOKIE_SECURE=true is set (cross-site cookies require Secure).
SESSION_COOKIE_SAME_SITE="lax"

# ── App URL (used in email links) ─────────────────────────────────────────────

# The public URL of the frontend app (REQUIRED).
# Used in email verification links and notification links.
APP_URL="http://localhost:5173"

# ── Email ─────────────────────────────────────────────────────────────────────

# Email transport: "console" (dev) or "smtp" (production).
# In production, console is blocked unless ALLOW_CONSOLE_EMAIL_IN_PROD=true.
EMAIL_PROVIDER="console"

# From address shown in emails.
EMAIL_FROM="DealLock <no-reply@deallock.xyz>"

# SMTP settings — required when EMAIL_PROVIDER=smtp.
# Works with Resend, Postmark, SendGrid, Mailgun, or any SMTP provider.
#
# Resend example (uses API key as SMTP password):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_...your_api_key...
#   SMTP_SECURE=false   # STARTTLS on port 587
#
# Direct TLS example:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Override: allow console email in production (not recommended).
# ALLOW_CONSOLE_EMAIL_IN_PROD=true

# ── Blockchain Event Indexer ───────────────────────────────────────────────────

# RPC endpoints for the event indexer.
# SEPOLIA_RPC_URL is required when INDEXER_ENABLED=true on Sepolia.
SEPOLIA_RPC_URL=
HARDHAT_RPC_URL=http://127.0.0.1:8545

# Enable agreement event indexing. Requires at least one RPC URL above.
INDEXER_ENABLED=false

# Indexer tuning (safe defaults work for most deployments).
INDEXER_POLL_MS=15000
INDEXER_CONFIRMATIONS=2
INDEXER_BLOCK_BATCH_SIZE=1000
INDEXER_LOOKBACK_BLOCKS=250000
INDEXER_MAX_AGREEMENTS_PER_TICK=25
INDEXER_LOG_LEVEL=info

# ── Factory Contract Indexer ───────────────────────────────────────────────────

# Enable factory AgreementCreated event indexing.
# Requires FACTORY_CONTRACTS, FACTORY_V2_CONTRACTS, or FACTORY_V3_CONTRACTS to be set.
FACTORY_INDEXER_ENABLED=false

# Comma-separated chainId:address pairs for deployed legacy Factory V1 contracts.
# Set after running: npx hardhat run scripts/deploy-factory-sepolia.ts --network sepolia
# Example: FACTORY_CONTRACTS=11155111:0xYourFactoryAddressHere
FACTORY_CONTRACTS=

# Comma-separated chainId:address pairs for payment-aware Factory V2 contracts.
# Factory V2 emits paymentToken and deploys DealLockMultiAsset (contractVersion 5).
# Example: FACTORY_V2_CONTRACTS=11155111:0xYourFactoryV2AddressHere
FACTORY_V2_CONTRACTS=

# Comma-separated chainId:address pairs for payment-aware Factory V3 contracts.
# Factory V3 emits paymentToken and deploys DealLockMultiAssetV2 (contractVersion 6).
# Example: FACTORY_V3_CONTRACTS=11155111:0xYourFactoryV3AddressHere
FACTORY_V3_CONTRACTS=

# Optional known stablecoin metadata for backend indexing and notifications.
# These only label configured token addresses; they are not an admin whitelist.
USDC_SEPOLIA_ADDRESS=
USDC_HARDHAT_ADDRESS=

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level: debug | info | warn | error (default: info).
LOG_LEVEL=info
