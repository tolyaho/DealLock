# ---- DealLock showcase — frontend environment ----
# The deployed site is a backend-free, wallet-free, deterministic DEMO.
# It needs NO environment variables to build or run. Everything below is OPTIONAL.

# Demo mode. Defaults ON for production builds (`vite build`): only the landing page
# + interactive escrow demo ship; the wallet-auth pages and /app dashboard are gated
# off. Set to "false" ONLY for local full-app development against your own backend.
# VITE_DEMO_ONLY=true

# Public repository URL for the escrow contracts. When set, the Security section's
# "Explore repository" buttons link here. Leave unset until the repo is published.
# VITE_REPO_URL=

# ---- Local full-app development only (IGNORED by the deployed demo) ----
# Not used by the public demo build. Only relevant if you run the full wallet/backend
# app locally with VITE_DEMO_ONLY=false. Never put secret keys in VITE_* — after a
# build they are public JavaScript.
# VITE_API_URL=http://localhost:4000
# VITE_SEPOLIA_RPC_URL=
# VITE_DEALLOCK_FACTORY_V3_SEPOLIA=
# VITE_USDC_SEPOLIA_ADDRESS=
